{
  "name": "@diraiks/tg-kit",
  "version": "0.1.0",
  "description": "Fastify plugins for building Telegram bots with grammY: commands, chat subscriptions and rate-limited broadcasts",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "fastify-plugin": "^6.0.1",
    "grammy": "^1.46.0"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "fastify": "^5.12.7",
    "fastify-tsconfig": "^3.0.0",
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
