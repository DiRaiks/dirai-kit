{
  "name": "dirai-kit",
  "private": true,
  "description": "Packages for Node services with Fastify, Postgres and Telegram bots",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.10",
    "npm": ">=11.21"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "types": "npm run types --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --check",
    "test": "npm test --workspaces",
    "pack:check": "npm run pack:check --workspaces",
    "examples:types": "npm run examples:types --workspaces --if-present",
    "template:check": "tsc -p scripts/template/tsconfig.json && vitest run --config scripts/template/vitest.config.ts",
    "release": "multi-semantic-release",
    "prepare": "husky"
  },
  "multi-release": {
    "tagFormat": "${name}@${version}",
    "ignorePrivate": true,
    "deps": {
      "bump": "override",
      "release": "patch",
      "prefix": "^"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "^10.0.1",
    "@lidofinance/multi-semantic-release": "^1.0.3",
    "@prometheus-io/client": "^0.16.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fastify": "^5.12.7",
    "fastify-tsconfig": "^3.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
