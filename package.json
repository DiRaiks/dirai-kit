{
  "name": "@diraiks/tg-kit",
  "version": "0.1.0",
  "description": "Fastify plugins for building Telegram bots with grammY: commands, chat subscriptions and rate-limited broadcasts",
  "license": "MIT",
  "author": "DiRaiks",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiRaiks/tg-bot-kit.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11.21"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --check",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run types && npm test && npm run build"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "fastify-plugin": "^6.0.1",
    "grammy": "^1.46.0"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fastify": "^5.12.7",
    "fastify-tsconfig": "^3.0.0",
    "globals": "^17.13.0",
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
