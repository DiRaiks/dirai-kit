{
  "name": "@dirai/tg-kit",
  "version": "0.1.0",
  "description": "Fastify plugins for building Telegram bots with grammY: commands, chat subscriptions and rate-limited broadcasts",
  "keywords": [
    "telegram",
    "telegram-bot",
    "grammy",
    "fastify",
    "fastify-plugin",
    "prometheus"
  ],
  "license": "MIT",
  "author": "DiRaiks",
  "homepage": "https://github.com/DiRaiks/tg-bot-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiRaiks/tg-bot-kit.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24.10",
    "npm": ">=11.21"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --check",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run types && npm test && npm run build && npm run pack:check",
    "pack:check": "node scripts/check-pack.mjs",
    "prepare": "husky",
    "examples:types": "tsc -p examples/tsconfig.json"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "fastify-plugin": "^6.0.1",
    "grammy": "^1.46.0"
  },
  "peerDependencies": {
    "fastify": "^5.0.0",
    "@prometheus-io/client": "^0.16.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@prometheus-io/client": "^0.16.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fastify": "^5.12.7",
    "fastify-tsconfig": "^3.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "@prometheus-io/client": {
      "optional": true
    }
  }
}
