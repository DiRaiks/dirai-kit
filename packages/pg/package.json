{
  "name": "@dirai-kit/pg",
  "version": "1.0.0",
  "description": "Postgres for Node services: a pool that survives dropped connections, drizzle-kit migrations under an advisory lock, health pings, error codes and test databases",
  "keywords": [
    "postgres",
    "postgresql",
    "pg",
    "drizzle",
    "migrations",
    "pglite",
    "testing"
  ],
  "license": "MIT",
  "author": "DiRaiks",
  "homepage": "https://github.com/DiRaiks/dirai-kit/tree/main/packages/pg#readme",
  "bugs": "https://github.com/DiRaiks/dirai-kit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiRaiks/dirai-kit.git",
    "directory": "packages/pg"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.10",
    "npm": ">=11.21"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run types && npm test && npm run build && npm run pack:check",
    "pack:check": "node ../../scripts/check-pack.mjs"
  },
  "peerDependencies": {
    "pg": "^8.16.0",
    "drizzle-orm": ">=0.44.0 <1",
    "@electric-sql/pglite": ">=0.3.0 <1"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    }
  }
}
